# Database Connection URLs (Required)
# These are automatically set by the Vercel + Neon integration
# For local development, get these from your Neon project dashboard
POSTGRES_PRISMA_URL="" # Used for connection pooling in production
POSTGRES_URL_NON_POOLING="" # Used for migrations and direct database operations

# Authentication (Required)
JWT_SECRET="" # Generate a secure random string (min 32 chars) for signing JWT tokens

# Production URLs
# These are automatically set by Vercel in production
# No need to set these in development
VERCEL_URL="" # Your deployment URL, e.g. "your-app.vercel.app"
