generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  USER
  ADMIN
}

enum Currency {
  USD
  AED
}

enum MembershipStatus {
  NON_MEMBER  // Default state
  MEMBER      // Active member
}

enum SessionStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

enum BookingStatus {
  PENDING_PAYMENT  // Initial state
  CONFIRMED       // After payment
  CANCELLED       // Cancelled by member
  COMPLETED       // Session completed
}

enum DrinkPackage {
  BASIC   // 2 drinks
  PREMIUM // 4 drinks
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  password          String
  role              UserRole        @default(USER)
  
  // Membership
  status            MembershipStatus @default(NON_MEMBER)
  membershipStart   DateTime?       // When subscription started
  membershipEnd     DateTime?       // When subscription ends
  activeBookingLimit Int            @default(3)  // Max concurrent bookings
  preferredCurrency Currency        @default(USD)
  
  // Password reset
  resetToken        String?         @unique
  resetTokenExpiry  DateTime?
  
  // Relations
  bookings          Booking[]
  purchases         Purchase[]      // On-site purchases
  
  // Timestamps
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([email])
  @@index([status])
}

model Session {
  id              String        @id @default(cuid())
  date            DateTime
  startTime       DateTime      // 6am weekdays, 9am weekends
  endTime         DateTime      // 9am weekdays, 12pm weekends
  
  // Capacity
  capacity        Int           @default(100)
  availableSlots  Int           @default(100)
  isWeekend       Boolean       @default(false)
  
  // Add-on slots
  iceSlots        Int           @default(9)  // 20-min slots
  reflexSlots     Int           @default(9)  // 20-min slots
  
  // Status
  isCancellable   Boolean       @default(true)   // Can be cancelled by members
  isPast          Boolean       @default(false)  // Session has ended
  status          SessionStatus @default(UPCOMING)
  
  // Relations
  bookings        Booking[]
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([date, startTime])
  @@index([date])
  @@index([startTime])
  @@index([status])
}

model Booking {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  sessionId       String
  session         Session         @relation(fields: [sessionId], references: [id])
  
  // Status
  status          BookingStatus   @default(PENDING_PAYMENT)
  isCancellable   Boolean         @default(false)
  isComplete      Boolean         @default(false)
  
  // Timestamps
  bookedAt        DateTime        @default(now())
  cancelledAt     DateTime?       // When booking was cancelled
  completedAt     DateTime?       // When session was completed
  
  // Payment
  currency        Currency        @default(USD)
  paymentStatus   String?         // For Stripe integration
  paymentIntentId String?         // Stripe payment intent ID
  
  // Package & Pricing
  bookingPackage  String?         // ONE_OFF, WEEKLY, BI_WEEKLY
  basePrice       Float           // Package or session price
  
  // Drinks Package
  drinkPackage    DrinkPackage?
  drinkPrice      Float           @default(0)
  drinkNotes      String?
  
  // Add-ons
  hasIceBath      Boolean         @default(false)
  iceSlotTime     DateTime?       // Must be within session time
  iceBathPrice    Float           @default(0)
  
  hasReflexology  Boolean         @default(false)
  reflexSlotTime  DateTime?       // Must be within session time
  reflexPrice     Float           @default(0)
  
  // Additional purchases
  purchases       Purchase[]
  
  // Totals
  totalPrice      Float           // Initial booking price
  finalPrice      Float?          // Including on-site purchases
  
  // Notes
  notes           String?
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

model Purchase {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  
  // Purchase details
  itemType    String    // BASIC_DRINK, PREMIUM_DRINK, ICE_BATH, REFLEXOLOGY
  quantity    Int
  price       Float
  currency    Currency  @default(USD)
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([bookingId])
}
